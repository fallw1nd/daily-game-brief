{
  "name": "daily-game-brief",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "validate": "npm run validate:data",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "check": "npm run typecheck && npm test && npm run validate:data && npm run validate:locales && npm run build",
    "build:locales": "node scripts/build-locale-index.mjs",
    "build:search": "node scripts/build-search-index.mjs",
    "media:audit": "node scripts/enrich-media.mjs --all",
    "media:enrich": "node scripts/enrich-media.mjs --apply",
    "titles:backfill": "node scripts/backfill-title-translations.mjs",
    "news:collect:am": "node scripts/collect-news.mjs --period=am",
    "news:collect:pm": "node scripts/collect-news.mjs --period=pm",
    "news:collect:daily": "node scripts/collect-news.mjs --period=daily",
    "news:health": "node scripts/update-source-health.mjs",
    "news:evidence": "node scripts/build-evidence.mjs",
    "news:ledger": "node scripts/update-event-ledger.mjs",
    "news:ledger-feedback": "node scripts/apply-editorial-feedback.mjs",
    "news:packet": "node scripts/editorialize.mjs",
    "brief:publish-decision": "node scripts/publish-editorial-decision.mjs",
    "brief:validate-submission": "node scripts/validate-editorial-submission.mjs",
    "brief:degraded-decision": "node scripts/build-degraded-decision.mjs",
    "news:audit": "node scripts/audit-news-coverage.mjs",
    "brief:sla:am": "node scripts/check-brief-sla.mjs --period=am",
    "brief:sla:pm": "node scripts/check-brief-sla.mjs --period=pm",
    "brief:sla:daily": "node scripts/check-brief-sla.mjs --period=daily",
    "predev": "npm run build:locales && npm run build:search",
    "prebuild": "npm run build:locales && npm run build:search"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
