{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fallw1nd.github.io/daily-game-brief/schemas/english-locale-overlay.schema.json",
  "title": "Daily Game Brief English presentation overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "editionId", "baseSchemaVersion", "factsDigest", "canonicalCopyDigest", "localeDigest", "archiveTitle", "entries", "upcoming"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "const": "en" },
    "editionId": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-(am|pm)$" },
    "baseSchemaVersion": { "enum": [1, 2] },
    "factsDigest": { "$ref": "#/$defs/digest" },
    "canonicalCopyDigest": { "$ref": "#/$defs/digest" },
    "localeDigest": { "$ref": "#/$defs/digest" },
    "archiveTitle": { "type": "string", "minLength": 12, "maxLength": 180 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "headline", "summary", "verification", "timeNote"],
        "properties": {
          "entryId": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 6, "maxLength": 220 },
          "summary": { "type": "string", "minLength": 12, "maxLength": 1200 },
          "verification": { "type": "string", "minLength": 6, "maxLength": 1200 },
          "timeNote": { "type": "string", "minLength": 4, "maxLength": 500 },
          "regionLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
          "releaseTypeLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
          "sourceLabels": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceIndex", "label"],
              "properties": {
                "sourceIndex": { "type": "integer", "minimum": 0 },
                "label": { "type": "string", "minLength": 2, "maxLength": 160 }
              }
            }
          },
          "mediaAlts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["assetKey", "alt"],
              "properties": {
                "assetKey": { "type": "string", "minLength": 1 },
                "alt": { "type": "string", "minLength": 2, "maxLength": 500 },
                "creditLabel": { "type": "string", "minLength": 2, "maxLength": 240 }
              }
            }
          }
        }
      }
    },
    "upcoming": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "upcomingId": { "type": "string", "minLength": 1 },
          "upcomingKey": { "type": "string", "minLength": 1 },
          "regionLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
          "releaseTypeLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
          "sourceLabel": { "type": "string", "minLength": 2, "maxLength": 160 },
          "coverAlt": { "type": "string", "minLength": 2, "maxLength": 500 }
        },
        "oneOf": [
          { "required": ["upcomingId"], "not": { "required": ["upcomingKey"] } },
          { "required": ["upcomingKey"], "not": { "required": ["upcomingId"] } }
        ]
      }
    },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "limited", "note"],
      "properties": {
        "checked": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "limited": { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "note": { "type": "string", "minLength": 4 }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
