    {
      "entryId": "2026-10-04-daily-news-2",
      "headline": "Jagex Announces New RuneScape MMO Under the Working Title RS4",
      "summary": "Jagex announced a new RuneScape MMO built in Unreal Engine. The working title RS4 is set in Gielinor, beginning in Ashenfall, and is intended to stand alongside RuneScape, Old School RuneScape, and RuneScape: Dragonwilds. Platforms are unannounced and release is still years away.",
      "verification": "The opened report explicitly attributes the announcement to an identified developer, publisher, or official account. Claims remain within the packet evidence.",
      "timeNote": "The source was published at 2026-10-04 04:00 Beijing time, within this edition's fixed window.",
      "regionLabel": "Global",
      "releaseTypeLabel": "announcement",
