  "archiveTitle": "Daily Brief | EA Closes BioWare and Ends the Next Mass Effect; Once Human Expansion Hits PS5",
  "entries": [
    {
      "entryId": "2026-10-22-daily-releases-0",
      "headline": "Once Human's Free Isles of Abyss Expansion Hits PS5 on October 22",
      "summary": "NetEase confirmed that Isles of Abyss will arrive free on PS5 on October 22, adding five ocean regions, mobile sea fortresses, underwater exploration, and a living-ocean threat called the Sunken Lord.",
      "verification": "The opened PlayStation Blog primary page supports the date, PS5 platform, free-expansion status, and gameplay details.",
      "timeNote": "PlayStation Blog published at 01:00 Beijing time on October 22. The expansion launches on October 22.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Free expansion",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "PlayStation Blog"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-features-0",
      "headline": "Stranger Than Heaven Hands-On Reveals Two-Sided Combat and Show-Business Management",
      "summary": "A PlayStation Blog hands-on says RGG Studio's game maps the protagonist's left and right sides to the shoulder buttons and triggers, while its show-business systems involve selecting singers, musicians, and stage effects. It launches for PS5 on January 15, 2027.",
      "verification": "The opened PlayStation Blog primary hands-on supports the gameplay details, protagonist, 50-year story, and PS5 date.",
      "timeNote": "PlayStation Blog published at 22:01 Beijing time on October 21. The PS5 version is dated January 15, 2027.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Hands-on preview",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "PlayStation Blog"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-news-0",
      "headline": "Incremental Game Round and Round Inc. Announced for Steam in November",
      "summary": "Murbong announced Round and Round Inc., where players spin a revolving door to attract customers and expand a small shop with the eventual goal of admitting 8.2 billion people. The Steam release is planned for November.",
      "verification": "The opened AUTOMATON report explicitly relays Murbong's October 21 announcement; platform, month, and mechanics are limited to that report.",
      "timeNote": "AUTOMATON published at 16:04 Beijing time on October 21. The Steam release is planned for November 2026.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Game announcement",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-industry-0",
      "headline": "EA Closes BioWare and Ends Development of the Next Mass Effect",
      "summary": "EA said it will not move forward with the early-development Mass Effect project handled by a small BioWare team and will close BioWare and its Edmonton office.",
      "verification": "The opened AUTOMATON report explicitly relays EA's same-day business statement; the studio, office, and project boundaries come from that relay.",
      "timeNote": "AUTOMATON published at 01:53 Beijing time on October 22 and relayed EA's same-day statement.",
      "regionLabel": "Canada",
      "releaseTypeLabel": "Studio closure and project cancellation",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-news-1",
      "headline": "Serious Sam: The Third Encounter Announced as a Direct Follow-Up to The Second Encounter",
      "summary": "Devolver Digital announced the PC title Serious Sam: The Third Encounter, whose story begins after Serious Sam: The Second Encounter.",
      "verification": "The opened AUTOMATON report explicitly relays Devolver Digital's October 22 announcement; title, PC platform, and story placement are limited to that report.",
      "timeNote": "AUTOMATON published at 08:35 Beijing time on October 22.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Game announcement",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-features-1",
      "headline": "Chronoscript: The Endless End: Chronoscript Developers Explain Delay After Demo Feedback Exposed Balance Issues",
      "summary": "In an interview, Shueisha Games producer Masami Yamamoto and DeskWorks developers said demo feedback showed that action feel and difficulty still needed work. The game is now targeted for early summer 2027, with Xbox Series X|S and Xbox on PC versions added.",
      "verification": "The opened AUTOMATON interview supports the delay rationale, interviewees, and added platforms; the older September 9 delay announcement is not presented as breaking news.",
      "timeNote": "AUTOMATON published the interview at 14:00 Beijing time on October 21. The target window is early summer 2027.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Developer interview",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-news-2",
      "headline": "Cyberpunk 2077 Version 2.5 'Edgerunners II' Update Launches October 22",
      "summary": "CD Projekt RED and Virtuos detailed version 2.5, which launches October 22 for PS5, Xbox Series, and PC, with the Switch 2 version following in the days after. PS4 and Xbox One will not receive the update.",
      "verification": "The opened Gematsu report explicitly relays CD Projekt RED and Virtuos; dates and platform differences are limited to that report.",
      "timeNote": "Gematsu published at 23:53 Beijing time on October 21. The main-platform update launches October 22, with Switch 2 following later.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Content update",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "Gematsu"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-releases-1",
      "headline": "Psychological Horror Game Cucina Stellata Launches Free on Steam",
      "summary": "CRITICAL REFLEX released Cucina Stellata for free on Steam. The game combines 19th-century Italian cuisine with a psychological-horror story inspired by cosmic horror.",
      "verification": "The opened 4Gamer report explicitly relays CRITICAL REFLEX's same-day launch announcement and free Steam availability.",
      "timeNote": "4Gamer published at 11:31 Beijing time on October 21 and said the game launched free on Steam that day.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Free release",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "4Gamer"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-industry-1",
      "headline": "Lucasfilm Games Says Star Wars Games Do Not Always Need AAA Scale",
      "summary": "Lucasfilm Games vice president Douglas Reilly said Star Wars needs major AAA games but can also work with experienced independent teams on AA projects across different genres, without limiting partners to the largest publishers.",
      "verification": "The opened AUTOMATON report identifies an October 15 interview with The Game Business. This entry reports the industry view, not a new-game announcement.",
      "timeNote": "AUTOMATON published at 12:41 Beijing time on October 21. The underlying interview took place on October 15.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Industry interview",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-22-daily-news-3",
      "headline": "Cooperative Board Game Diablo: Unbound Announced for 1–4 Players",
      "summary": "Glass Cannon Unplugged announced Diablo: Unbound, a cooperative dungeon-battler board game for one to four players featuring familiar classes, locations, and monsters. Its Gamefound campaign is planned for Q1 2027.",
      "verification": "The opened IGN report cites Glass Cannon Unplugged's announcement and official social post; player count, format, and campaign window are limited to that evidence.",
      "timeNote": "IGN published at 01:57 Beijing time on October 22. The Gamefound campaign is planned for Q1 2027.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Board-game announcement",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "IGN"
        }
      ]
    }
  ],
