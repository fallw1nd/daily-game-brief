    {
      "entryId": "2026-10-14-daily-news-2",
      "headline": "Ace Combat 8: Wings of Theve: Ace Combat 8’s Steam preorder bonus ACE COMBAT ZERO is getting a standalone app",
      "summary": "Bandai Namco says it is preparing a separately installable and launchable app for the Steam preorder-bonus version of ACE COMBAT ZERO. It will be limited to players who already own the preorder bonus, and no release date has been announced.",
      "verification": "An opened trusted media report clearly relays Bandai Namco’s October 13 notice, including the standalone-app plan, eligibility limit, and unannounced timing.",
      "timeNote": "Announced October 13, 2026; release date unannounced",
      "releaseTypeLabel": "Feature update",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
