  "entries": [
    {
      "entryId": "2026-10-14-daily-news-0",
      "headline": "Helldivers 2’s Scope of Authority Premium Warbond launches October 20",
      "summary": "Arrowhead announced the Scope of Authority Premium Warbond for Helldivers 2, focused on long-range and clandestine combat with gear including the R-40 Sightliner bolt-action sniper rifle and AMW-20 Apex anti-materiel rifle.",
      "verification": "An opened first-party PlayStation Blog post confirms the Warbond name, launch date, and highlighted equipment.",
      "timeNote": "October 20, 2026",
      "releaseTypeLabel": "Premium Warbond",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "PlayStation Blog"
        }
      ]
    },
    {
      "entryId": "2026-10-14-daily-releases-0",
      "headline": "Valor Mortis is now available on Xbox Series X|S, Xbox on PC, and Game Pass",
      "summary": "One More Level’s soulslike action game Valor Mortis is now available on Xbox Series X|S, Xbox on PC, and Game Pass, with Xbox Play Anywhere support.",
      "verification": "An opened first-party Xbox Wire article explicitly confirms availability, platforms, Game Pass, and Xbox Play Anywhere support.",
      "timeNote": "October 13, 2026",
      "releaseTypeLabel": "Full release",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "Xbox Wire"
        }
      ]
    },
    {
      "entryId": "2026-10-14-daily-news-1",
      "headline": "Dyping Working: 作業監視ゲーム announced for Steam in 2027",
      "summary": "PLAYISM announced Dyping Working: 作業監視ゲーム, a Dyping spin-off from Heaviside Creations in which an on-screen eye monitors the player’s work. It is planned for PC via Steam in 2027.",
      "verification": "Two opened media reports independently match on the developer, platform, and 2027 release window; one reproduces PLAYISM’s announcement text.",
      "timeNote": "Announced October 13, 2026; planned for 2027",
      "releaseTypeLabel": "Announcement",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        },
        {
          "sourceIndex": 1,
          "label": "電ファミニコゲーマー News"
        }
      ]
    },
    {
      "entryId": "2026-10-14-daily-releases-1",
      "headline": "Bless You Again demo launches on Steam",
      "summary": "Gino released a Steam demo for Bless You Again, featuring two of five playable characters and its melee-to-magic roguelite loop. The full game is planned for 2026.",
      "verification": "Two opened media reports independently confirm the demo launch, Steam platform, and 2026 window for the full game.",
      "timeNote": "Demo launched October 12, 2026",
      "releaseTypeLabel": "Demo",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "4Gamer News Topics"
        },
        {
          "sourceIndex": 1,
          "label": "電ファミニコゲーマー News"
        }
      ]
    },
    {
      "entryId": "2026-10-14-daily-releases-2",
      "headline": "Monster Farm Advance and two other GBA games join Nintendo Classics",
      "summary": "Nintendo added Kuru Kuru Kururin Paradise, Metal Slug Advance, and Monster Farm Advance to Game Boy Advance – Nintendo Classics for Nintendo Switch Online + Expansion Pack members.",
      "verification": "An opened trusted media report clearly relays Nintendo’s October 14 release, the three games, and the membership requirement; the packet does not include a readable matching Nintendo detail page.",
      "timeNote": "October 14, 2026",
      "releaseTypeLabel": "Subscription catalog release",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-14-daily-news-2",
      "headline": "Ace Combat 8: Wings of Theve: Ace Combat 8’s Steam preorder bonus ACE COMBAT ZERO is getting a standalone app",
      "summary": "Bandai Namco says it is preparing a separately installable and launchable app for the Steam preorder-bonus version of ACE COMBAT ZERO. It will be limited to players who already own the preorder bonus, and no release date has been announced.",
      "verification": "An opened trusted media report clearly relays Bandai Namco’s October 13 notice, including the standalone-app plan, eligibility limit, and unannounced timing.",
      "timeNote": "Announced October 13, 2026; release date unannounced",
      "releaseTypeLabel": "Feature update",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    }
