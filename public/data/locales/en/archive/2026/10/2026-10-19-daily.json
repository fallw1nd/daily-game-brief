  "archiveTitle": "Daily Brief | NVIDIA denies RTX 5090 discontinuation",
  "entries": [
    {
      "entryId": "2026-10-19-daily-news-0",
      "headline": "RTA in Japan Winter 2026 announces its game lineup",
      "summary": "Denfaminicogamer reports that RTA in Japan has announced selected and backup games for its winter event, including a blindfolded Super Mario 64 run. The event is planned for December 25–31 in Tokyo, with the detailed schedule due on October 25.",
      "verification": "Checked the opened media report in the original acknowledged packet; claims remain attributed to that report.",
      "timeNote": "The source publication timestamp falls inside this edition’s fixed window.",
      "regionLabel": "Global",
      "releaseTypeLabel": "News report",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "Denfaminicogamer"
        }
      ]
    },
    {
      "entryId": "2026-10-19-daily-industry-0",
      "headline": "NVIDIA executive denies RTX 5090 discontinuation rumor",
      "summary": "AUTOMATON, citing Taiwanese media reports, says NVIDIA senior vice president Jeff Fisher denied rumors that GeForce RTX 5090 production had ended and said shipments would continue. The statement does not establish that supply constraints have eased.",
      "verification": "Checked the opened media report in the original acknowledged packet; claims remain attributed to that report.",
      "timeNote": "The source publication timestamp falls inside this edition’s fixed window.",
      "regionLabel": "Global",
      "releaseTypeLabel": "News report",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "AUTOMATON"
        }
      ]
    },
    {
      "entryId": "2026-10-19-daily-news-1",
      "headline": "Stella Sora: Yostar’s story event is scheduled for October 20 after maintenance",
      "summary": "4Gamer reports that Yostar announced a new story event in its October 18 first-anniversary broadcast. The event is scheduled to begin after maintenance on October 20 and introduces the limited character named in the Japanese announcement. No simultaneous regional rollout is inferred.",
      "verification": "Checked the opened media report in the original acknowledged packet; claims remain attributed to that report.",
      "timeNote": "The source publication timestamp falls inside this edition’s fixed window.",
      "regionLabel": "Scope stated by the source",
      "releaseTypeLabel": "News report",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "4Gamer News Topics"
        }
      ]
    },
    {
      "entryId": "2026-10-19-daily-releases-0",
      "headline": "NumeNume launches on Steam and mobile with up to 24-player letter hide-and-seek",
      "summary": "A developer announcement carried by Denfaminicogamer says Phuriko released NumeNume on Steam, iOS and Android on October 17. Players hide as similar-looking characters in online cross-platform matches for one to 24 players. Mobile versions are free with feature limits and ads, with a paid full-version unlock.",
      "verification": "Checked the opened media report in the original acknowledged packet; claims remain attributed to that report.",
      "timeNote": "The source publication timestamp falls inside this edition’s fixed window.",
      "regionLabel": "Global",
      "releaseTypeLabel": "News report",
      "sourceLabels": [
        {
          "sourceIndex": 0,
          "label": "Denfaminicogamer"
        }
      ]
    }
