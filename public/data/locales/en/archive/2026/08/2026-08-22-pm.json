  "archiveTitle": "Evening Brief | Rizz Dungeon Delayed to 2027",
  "entries": [
    {
      "entryId": "2026-08-22-pm-observations-0",
      "headline": "Addendum: Delayed from September 17 to 2027",
      "summary": "Developer Snoozy Kazoo announced that this dungeon-crawling romance adventure game will no longer launch on its originally scheduled September 17 date, with a new release window of 2027; the team stated the delay is to avoid crunch and expand content. The official Bluesky statement and Steam store page have both been directly verified, but the original announcement occurred during the morning brief window, so this entry is only an addendum for missed coverage and does not count as new news for this period.",
      "verification": "Opened the developer's official Bluesky post and verified the UTC timestamp and delay reason; the Steam store currently lists a 2027 release. Gematsu is cited only as supplementary coverage.",
      "timeNote": "Official Bluesky post published on 2026-08-21 17:00:32 UTC, converted to Beijing time 2026-08-22 01:00; primary verification completed this round.",
      "regionLabel": "Global",
      "releaseTypeLabel": "Delay",
