  "archiveTitle": "Morning Brief | Withering Realms set for September 2",
  "entries": [
    {
      "entryId": "2026-08-23-am-news-0",
      "headline": "Steam Early Access begins September 2",
      "summary": "Independent developer Moonless Formless has confirmed that the horror action RPG Withering Realms will enter Early Access on Steam on September 2. The version will be playable from start to finish at launch, featuring 50 weapons and tools, 70 charms, 7 large dungeons, and 110 monster types. During Early Access, the team will continue adding side content, endgame modes, and balance adjustments. A full release and console versions are planned for 2027.",
      "verification": "The developer's official website, Steam store page, and Steam official news were actually opened and checked for the developer, platform, Early Access nature, September 2 date, and content scope; Gematsu was used for independent verification of the exact announcement time.",
      "timeNote": "Steam official news only shows August 22 and an on-page time; Gematsu's article is dated 2026-08-22 10:00 EDT, which converts to 22:00 Beijing time, falling within this window.",
      "regionLabel": "Global / Store time zones vary",
      "releaseTypeLabel": "Early Access date set",
