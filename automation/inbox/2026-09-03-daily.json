      "entries": [
        {
          "eventKey": "bb4237bc8ab48e7e6770",
          "headline": "Another Eden Begins demo launches with the first six chapters and save carryover",
          "summary": "AUTOMATON and 4Gamer report that the free Another Eden Begins demo is now available on PC via Steam and Nintendo Switch. It covers the story through Chapter 6, and save data can carry over to the full game when it launches on September 17.",
          "verification": "Two independent opened media pages confirm the demo launch, Chapter 6 scope, and save-data carryover.",
          "timeNote": "The AUTOMATON report was published at 09:56 Beijing time on September 3, before the edition's 10:10 cutoff.",
          "regionLabel": "Global",
          "releaseTypeLabel": "Demo",
          "sourceLabels": [
            {"sourceIndex": 0, "label": "AUTOMATON"},
            {"sourceIndex": 1, "label": "4Gamer News Topics"}
          ]
        },
        {
          "eventKey": "4c6324ceb1e52b03b4c8",
          "headline": "Fable director confirms character customization, says trailer heroes are only examples",
          "summary": "In a gamescom 2026 interview with IGN, Fable game director Ralph Fulton confirmed that the RPG includes character customization and explained that the different heroes shown in trailers are examples of appearances players can choose. The report also reiterates a February 23, 2027 launch.",
          "verification": "The opened IGN interview directly quotes game director Ralph Fulton on character customization and states the launch date.",
          "timeNote": "The IGN interview was published at 00:05 Beijing time on September 3, inside the fixed edition window.",
          "regionLabel": "Global",
          "releaseTypeLabel": "Interview",
          "sourceLabels": [{"sourceIndex": 0, "label": "IGN Games"}]
        },
        {
          "eventKey": "6c63b2179d5891edb24f",
          "headline": "BOMBANANA! launches as Steam peak concurrency passes 12,000, report says",
          "summary": "AUTOMATON reports that Lefto Studio's three-player bomb-defusal game BOMBANANA! has launched on Steam. Its demo had drawn more than six million plays, while the full release surpassed 12,000 peak concurrent players shortly after launch.",
          "verification": "The opened AUTOMATON report supports the launch, demo-play count, and launch-period peak concurrency figures.",
          "timeNote": "The AUTOMATON report was published at 09:28 Beijing time on September 3, before the edition's 10:10 cutoff.",
          "regionLabel": "Global",
          "releaseTypeLabel": "Launch",
          "sourceLabels": [{"sourceIndex": 0, "label": "AUTOMATON"}]
        },
        {
          "eventKey": "c89b281d5cf8485d88a5",
          "headline": "Emberward leaves Early Access on September 17 with a fifth area in version 1.0",
          "summary": "AUTOMATON reports that Refic Games will release Emberward 1.0 on September 17 after roughly two years in Early Access. Version 1.0 adds a fifth area built around void-corrupted terrain and a mechanic that lets players create floor space over the void.",
          "verification": "The opened AUTOMATON report supports the full-release date and the main fifth-area addition planned for version 1.0.",
          "timeNote": "The AUTOMATON report was published at 09:14 Beijing time on September 3, before the edition's 10:10 cutoff.",
          "regionLabel": "Global",
          "releaseTypeLabel": "Release date",
          "sourceLabels": [{"sourceIndex": 0, "label": "AUTOMATON"}]
        }
